NEXT_PUBLIC_API_HOST=scan.ctcchain.com
NEXT_PUBLIC_API_PROTOCOL=https
NEXT_PUBLIC_STATS_API_HOST=https://api-scan.ctcchain.com
NEXT_PUBLIC_NETWORK_NAME=CTC mainnet
NEXT_PUBLIC_NETWORK_SHORT_NAME=CTC chain
NEXT_PUBLIC_NETWORK_ID=12301
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=CTC
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=CTC
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_API_BASE_PATH=/
NEXT_PUBLIC_APP_HOST=scan.ctcchain.com
NEXT_PUBLIC_APP_PROTOCOL=https
NEXT_PUBLIC_HOMEPAGE_CHARTS=['daily_txs']
NEXT_PUBLIC_VISUALIZE_API_HOST=https://scan.ctcchain.com:8081
NEXT_PUBLIC_IS_TESTNET=false
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=wss
NEXT_PUBLIC_API_SPEC_URL=https://raw.githubusercontent.com/blockscout/blockscout-api-v2-swagger/main/swagger.yaml
# Required to enable blockchain interaction
# 在 https://dashboard.reown.com/ 注册PROJECT_ID
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=c500efef072f9b291f555ad6da2b64bb
ENABLE_WALLETCONNECT=true
NEXT_PUBLIC_AD_BANNER_PROVIDER=none
NEXT_PUBLIC_NETWORK_RPC_URL=https://rpc.ctcchain.com
