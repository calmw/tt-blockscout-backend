NEXT_PUBLIC_NETWORK_SHORT_NAME=CTC chain
NEXT_PUBLIC_NETWORK_ID=12302
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=CTC
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=CTC
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_API_BASE_PATH=/
